{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for Dumboo expense tracker",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "currency": { "type": "string", "maxLength": 10 },
        "defaultMonthlyBudget": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income or expense transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 120 },
        "note": { "type": "string", "maxLength": 500 },
        "paymentMethod": { "type": "string", "enum": ["cash", "bank", "credit_card", "promptpay", "ewallet"] },
        "isEssential": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "category", "date", "title"]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Target budget for a specific month",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "yearMonth": { "type": "string", "maxLength": 16 },
        "targetBudget": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "yearMonth", "targetBudget"]
    },
    "CustomCategory": {
      "title": "CustomCategory",
      "description": "Custom transaction category created by user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "icon": { "type": "string", "maxLength": 32 },
        "color": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User income and expense transactions"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "MonthlyBudget",
      "description": "User monthly budget limits"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "CustomCategory",
      "description": "User defined custom categories"
    }
  }
}
