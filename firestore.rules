rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection helper
    match /test/connection {
      allow read: if isSignedIn();
    }

    // User Profile
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'currency', 'defaultMonthlyBudget', 'createdAt'])
        && data.uid == userId
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('defaultMonthlyBudget' in data) || (data.defaultMonthlyBudget is number && data.defaultMonthlyBudget >= 0))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Transaction Validation
    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'type', 'amount', 'category', 'date', 'title'])
        && data.keys().hasOnly(['id', 'userId', 'type', 'amount', 'category', 'date', 'title', 'note', 'paymentMethod', 'isEssential', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && (data.type == 'income' || data.type == 'expense')
        && data.amount is number && data.amount >= 0
        && data.category is string && data.category.size() > 0 && data.category.size() <= 64
        && data.date is string && data.date.size() >= 10 && data.date.size() <= 32
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && (!('paymentMethod' in data) || (data.paymentMethod in ['cash', 'bank', 'credit_card', 'promptpay', 'ewallet']))
        && (!('isEssential' in data) || (data.isEssential is bool))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Monthly Budget Validation
    function isValidBudget(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'yearMonth', 'targetBudget'])
        && data.keys().hasOnly(['id', 'userId', 'yearMonth', 'targetBudget', 'updatedAt'])
        && data.userId == userId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.yearMonth is string && data.yearMonth.size() >= 6 && data.yearMonth.size() <= 16
        && data.targetBudget is number && data.targetBudget >= 0
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Custom Category Validation
    function isValidCategory(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'type', 'icon', 'color', 'createdAt'])
        && data.userId == userId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 64
        && (data.type == 'income' || data.type == 'expense')
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 32))
        && (!('color' in data) || (data.color is string && data.color.size() <= 32))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid;
      allow delete: if false;

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming(), userId)
          && incoming().id == transactionId;
        allow update: if isOwner(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(budgetId)
          && isValidBudget(incoming(), userId)
          && incoming().id == budgetId;
        allow update: if isOwner(userId)
          && isValidId(budgetId)
          && isValidBudget(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(budgetId);
      }

      // Custom Categories subcollection
      match /categories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(categoryId)
          && isValidCategory(incoming(), userId)
          && incoming().id == categoryId;
        allow update: if isOwner(userId)
          && isValidId(categoryId)
          && isValidCategory(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(categoryId);
      }
    }
  }
}
